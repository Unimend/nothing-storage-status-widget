<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/card" android:clipToOutline="true">
        <ImageView android:id="@+id/content" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitCenter"
            android:contentDescription="存储与设备状态" />
        <FrameLayout android:id="@+id/refresh" android:layout_width="match_parent"
            android:layout_height="match_parent" android:contentDescription="刷新存储与设备状态" />
    </FrameLayout>
</FrameLayout>
